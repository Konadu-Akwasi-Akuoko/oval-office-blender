# Licensed assets — Envato files are tied to a personal subscription.
# This repo is public. These must never be committed.
assets/

# Blender
# The .blend is a BUILD ARTIFACT, not source. scripts/ regenerates it from
# nothing. Committing it would put a growing binary in a public repo that
# still would not open correctly, since assets/ is excluded anyway.
# See docs/learnings.md, "The .blend is not source".
*.blend
*.blend1
*.blend2
*.blend@

# Renders
renders/
*.mp4
*.mkv
*.exr
*.png

# Reference images are public domain and ARE committed, so re-include them.
# The ** matters: a bare `reference/*.png` misses reference/progress/, which is
# where the build's own progress renders go, and they were silently dropped.
!reference/**/*.jpg
!reference/**/*.png

# Python bytecode — regenerated by Blender on every script run.
__pycache__/
*.pyc

# macOS
.DS_Store
